  },
  "metafileVersion": 1,
  "label": "[Face Tracking] Zoom to face",
  "steps": 2,
  "revision": 2,
  "parameters": [
    {
      "name": "step_max",
      "label": "step max",
      "type": "int",
      "min": 1,
      "max": 7,
      "default": 7,
      "devmode": true
    },
    {
      "type": "facetracking",
      "name": "fd",
      "reset_on_face_lost": {
        "prompt": true,
        "default": false
      }
    },
    {
      "name": "prev_step0",
      "type": "prev_frame",
      "step": 0
    },
    {
      "name": "zoom_level",
      "label": "Zoom level",
      "type": "double",
      "slider": true,
      "min": 0,
      "max": 3.0,
      "default": 0.9,
      "step": 0.001
    },
    {
      "name": "smoothing",
      "label": "Smoothing",
      "type": "double",
      "slider": true,
      "min": 0,
      "max": 1000.0,
      "default": 200.0,
      "step": 1.0
    },
    {
      "name": "show_ref_points",
      "label": "Show ref. points (devmode)",
      "type": "bool",
      "devmode": true,
      "default": false
    },
    {
      "name": "preserve_aspect_ratio",
      "label": "Preserve aspect ratio",
      "type": "bool",
      "default": true
    },
    {
      "name": "use_tilt_compensate",
      "label": "Compensate for head tilt",
      "type": "bool",
      "default": true
    }
  ]
}
